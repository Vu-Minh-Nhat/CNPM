# Sao chép thành backend/.env và điền cấu hình trên máy.
# Không commit file .env hoặc mật khẩu thật.

NODE_ENV=development
PORT=3000

# Các origin Frontend được phép gọi API, phân cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Kết nối PostgreSQL của từng thành viên.
DATABASE_URL=

# Khóa ký JWT. Bắt buộc cấu hình khi chạy production.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Mật khẩu tài khoản mẫu: ít nhất 12 ký tự, tối đa 72 byte UTF-8.
SEED_PASSWORD=

# Nest Observe: tùy chọn, để trống nếu không sử dụng.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=