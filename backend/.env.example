# Local development. Copy this file to .env; do not commit .env.
NODE_ENV=development
PORT=3000

# Frontend origins allowed to call the API from a browser, separated by commas.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Generate a local value with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Required in production. Keep the actual value in .env or deployment secrets.
JWT_SECRET=

# PostgreSQL preparation for AI-29. Not required to start the AI-27 demo.
# Fill this only when a PostgreSQL database is available, then run npm run db:check.
DATABASE_URL=

# Optional external observability. Leave both empty for local development.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
